{
  "name": "jarvis-core",
  "version": "1.0.0",
  "description": "JARVIS Personal AI Desktop Assistant",
  "author": "StretchWave",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "start": "node --experimental-strip-types src/index.ts",
    "dev": "node --experimental-strip-types src/index.ts",
    "desktop:dev": "electron electron/main.cjs",
    "desktop:build": "electron-builder",
    "tts:setup": "python scripts/setup_kokoro.py",
    "daemon:opencode": "opencode service start",
    "daemon:opencode:status": "opencode service status",
    "daemon:opencode:restart": "opencode service restart",
    "daemon:opencode:bootstrap": "node --experimental-strip-types -e \"import { OpenCodeClient } from './src/opencode_client.ts'; import { Logger } from './src/logger.ts'; const c = new OpenCodeClient('', new Logger('daemon', 'info'), { spawnIfDown: true }); await c.ensureDaemonRunning();\"",
    "test": "node --experimental-strip-types tests/run_all.ts",
    "test:gateway": "node --experimental-strip-types tests/test_opencode_gateway.ts",
    "test:smoke": "node --experimental-strip-types tests/smoke_manual_tests.ts"
  },
  "build": {
    "appId": "com.jarvis.desktop",
    "productName": "JARVIS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "public/**/*",
      "src/**/*",
      "electron/**/*",
      "scripts/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "dir",
        "nsis"
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  }
}
